# Copie este arquivo para .env e preencha. NUNCA publique o .env.

# --- IA generativa (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# modelos 100% gratuitos (variante :free do OpenRouter); a 1ª reserva é de outro provedor
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free

# --- App do administrador ---
# dev | producao (em produção a senha e o segredo JWT são obrigatórios)
EM_RAIZES_AMBIENTE=dev
EM_RAIZES_ADMIN_USUARIO=admin
EM_RAIZES_ADMIN_SENHA=troque-esta-senha
# gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
EM_RAIZES_SEGREDO_JWT=
# origens permitidas (CORS) quando o frontend roda em outro endereço
EM_RAIZES_ORIGENS_CORS=http://localhost:5173

# --- Clima ---
# real = chuva medida (Cemaden + previsão Open-Meteo); ou um cenário simulado: seco, moderada, forte, extrema
EM_RAIZES_SIM_CENARIO=real
EM_RAIZES_CHUVA_CIDADE=Petrópolis
EM_RAIZES_CHUVA_UF=RJ
EM_RAIZES_CHUVA_IBGE=3303906
EM_RAIZES_CHUVA_LAT=-22.505
EM_RAIZES_CHUVA_LON=-43.178
# opcional: id de um pluviômetro do Cemaden perto do morro (vazio = percentil 75 dos pluviômetros da cidade)
EM_RAIZES_CHUVA_ESTACAO=
EM_RAIZES_CHUVA_VALIDADE_MIN=10

# --- Notificações push (Web Push) ---
# em produção é obrigatório para ter push; em dev é gerada sozinha em .dados/vapid.json
# gere com: python -c "from em_raizes.operacoes.notificacoes import gerar_chave_privada as g; print(g())"
EM_RAIZES_VAPID_PRIVADA=
EM_RAIZES_VAPID_CONTATO=mailto:admin@example.com

# --- Simulação do morro ---
EM_RAIZES_SIM_SEMENTE=42
EM_RAIZES_SIM_TAMANHO=24
# 1.0 = durações normais; 0.5 = tudo 2x mais rápido
EM_RAIZES_SIM_ESCALA_TEMPO=1.0
